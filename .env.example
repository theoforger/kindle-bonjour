# Copy to .env and edit. Read by compose.yaml.

# This host's LAN IP, the address the Kindle uses. Required for the Kindle
# to reach the server (the default, 127.0.0.1, is local only).
BIND_IP=192.168.1.10
HOST_PORT=8080

# Owner of ./data (run `id -u` and `id -g`).
PUID=1000
PGID=1000

TZ=America/Toronto

# Optional: seed the first config. Ignored once data/config.json exists.
# HA_URL=http://192.168.1.20:8123
# HA_TOKEN=
